    300
   ],
   "parameters": {
    "jsCode": "const q=$('Panel Judge Call').first().json.body||{};const j=$json||{};\nconst pe=e=>{const o={message:String((typeof e==='string')?e:((e&&(e.message||e.description))||JSON.stringify(e)))};if(e&&typeof e==='object'){for(const f of Object.keys(e))if(e[f]!=null&&typeof e[f]!=='object'&&!(f in o))o[f]=e[f];for(const f of ['name','description','httpCode','status','statusCode','code'])if(e[f]!=null&&typeof e[f]!=='object')o[f]=e[f];}return o;};\nconst response=j.error?Object.assign({},j,{error:pe(j.error)}):j;\nreturn [{json:{payload:{nonce:q.ppj_nonce,slot:q.ppj_slot,provider:q.ppj_provider,seat:q.seat||null,response_text:JSON.stringify(response)}}}];"
   }
  },
