const u=C?C.uncured:0;if(u>0){p.drv_uncured=(p.drv_uncured||0)+u;any=true;}const __offR=res.filter(r=>r.cured&&r.ans==='CHANGE'&&/was applied/.test(r.why)&&/^E-APPLY S\d+$/.test(r.src)&&String(p.verdict_raw).split('\n').some(l=>/^\[AUDIT v4\d: .*counted in drv_uncured/.test(l)&&!/not counted in drv_uncured/.test(l)&&l.includes('SEAT: '+g.seat+';')&&new RegExp('(ITEMS: |\\); )'+r.src.slice(8)+' \\(').test(l)));const __offF=__offR.filter((r,i)=>__offR.findIndex(z=>z.src===r.src)===i),__off=__offF.map(r=>r.src);if(__off.length&&p.drv_uncured){p.drv_uncured=Math.max(0,p.drv_uncured-__off.length);any=true;} /* pkgGCC rev 2: a line the gate cures loses its send-back count, once per counted S; a TRIAL "not counted" line is no count */