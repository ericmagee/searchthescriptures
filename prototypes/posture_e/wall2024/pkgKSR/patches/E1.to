const __cc=(()=>{const L=new Set();for(const [n,k] of [['Close Enforcer Record','cec'],['Judge Contradiction Record','jcc']]){try{const x=$(n);if(!x||!x.isExecuted)continue;const j=x.first().json;((j&&j[k]&&j[k].confirmed)||[]).forEach(y=>L.add(y.side+' '+(+y.link)));}catch(e){}}return L;})();
const __ecC=l=>{const t=String(l||'').replace(/[*_`]+/g,'').trim();const m=t.match(/^D(\d+)\s+vs\.?\s+C(\d+)\b/i),a=t.match(/\[AUDIT: LINK (\d+) BROKEN BY A CONFIRMED CLOSING CONTRADICTION -- (DEFENDER|CHALLENGER)\b/);return m&&a&&__cc.has(a[2]+' '+a[1])&&(a[2]==='DEFENDER'?m[1]:m[2])===a[1]?'D'+m[1]+' VS C'+m[2]:null;};
const __ecb=(seat,l)=>{if(__ecC(l))return true;const f=String(l||'').replace(/[*_`]+/g,'').trim().match(/^FORCED\s*:\s*D(\d+)\s+vs\.?\s+C(\d+)\b/i);return !!f&&String(said[seat]||'').split('\n').some(z=>__ecC(z)==='D'+f[1]+' VS C'+f[2]);}; /* pkgECB rev 2 */
const MAX=60;const bySeat=new Map();const out=[];const not_sent=[];for(const x of dis){if(__ecb(x.seat,x.flagged_line)){not_sent.push({seat:x.seat,rule:x.rule,item:x.item,why:'the engine\'s closing-contradiction break; a send-back does not undo it (pkgECB)'});continue;}