/* pkgEAD: a DeepSeek E-ANS or E-HOLD reason that reads a deferral as the whole answer is not sent back when the pkgVP3 code finds an answer behind it */
const __ead=(()=>{let R=null;for(const n of [1,2,3]){try{const z=$('Panel Cure Normalize '+n);if(z&&z.isExecuted)for(const it of z.all()){const c=it.json&&it.json.cure;if(c&&c.rounds){R=c.rounds;break;}}}catch(e){}if(R)break;}
 const P=w=>{const d=w.match(/^\[[CD]R\d\] the answer defers to \[[CD]R\d\], which answers .{1,40}? (without its exact reference \(line|\((.*)\)$)/);return d?!!d[1].startsWith('w')||P(d[2]):/^\[[CD]R\d\] (the deferral to LINK \d.{0,18}? names an answer|answer to .{1,40}?: (the answer (carries its own layer|runs \d)|a sentence is neither))/.test(w);};
 return x=>{if(!R||!/^E-(ANS|HOLD)$/.test(x.rule)||x.und||x.abs||x.ecl)return null;const r=why(x);if(!/\(right:\s*(MISSES|BROKEN)\)/.test(r)||!/(under|at|in|see)\s+(LINK|Link|link|premise)\s*\d|\banswered\s+(at|under|in)\b|\banswer(s|ed)?\s+it\s+fully\b|\bpointer\b|\bdefers?\b/.test(r))return null;let v;try{v=vp3Trial2024({rule:x.rule,item:x.item,line:x.flagged_line,reason:r},null,R,null);}catch(e){return null;}const t='TRIAL pkgVP3: code check does not agree, not an item -- ',w=v&&v.note&&v.note.startsWith(t)?v.note.slice(t.length):'';return w&&P(w)?w:null;};})();
