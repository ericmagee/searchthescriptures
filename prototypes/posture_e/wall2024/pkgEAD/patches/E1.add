/* pkgEAD (W3 4332, W1 study): a DeepSeek E-ANS or E-HOLD reason that reads a deferral ("under LINK n", "a pointer") as the whole answer is not sent back when the pkgVP3 code finds an answer behind it */
const __ead=(()=>{let R=null;for(const n of ['Panel Cure Normalize 1','Panel Cure Normalize 2','Panel Cure Normalize 3']){try{const z=$(n);if(z&&z.isExecuted)for(const it of z.all()){const c=it.json&&it.json.cure;if(c&&c.rounds){R=c.rounds;break;}}}catch(e){}if(R)break;}
 return x=>{if(!R||(x.rule!=='E-ANS'&&x.rule!=='E-HOLD')||x.und||x.abs||x.ecl)return null;const r=why(x);if(!/\(right:\s*(?:MISSES|BROKEN)\)/.test(r)||!/(?:under|at|in|see)\s+(?:LINK|Link|link|premise)\s*\d|\banswered\s+(?:at|under|in)\b|\banswer(?:s|ed)?\s+it\s+fully\b|\bpointer\b|\bdefers?\b/.test(r))return null;let v=null;try{v=vp3Trial2024({rule:x.rule,item:x.item,line:x.flagged_line,reason:r},null,R,null);}catch(e){return null;}return v&&/code check does not agree/.test(v.note)?v.note.replace(/^.*?not an item -- /,''):null;};})();
