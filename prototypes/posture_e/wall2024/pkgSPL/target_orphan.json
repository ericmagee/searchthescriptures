.all().map(x => x.json);\nconst pamphlets = $('Fetch kb_pamphlets').all().map(x => x.json);\nconst books = $('Fetch kb_books').all().map(x => x.json);\nconst chapters = $('Fetch kb_book_chapters').all().map(x => x.json);\nif (conclusions.length === 0 || fold.length === 0 || pamphlets.length === 0 || books.length === 0 || chapters.length === 0) throw new Error('ORPHAN SNAPSHOT INCOMPLETE — a table fetched zero rows (conclusions=' + conclusions.length + ' fold=' + fold.length + ' pamphlets=' + pamphlets.length + ' books=' + books.length + ' chapters=' + chapters.length + '). Aborting rather than writing a hollow backup.');\nconst chapterChars = chapters.reduce((s, c) => s + ((c.content || '').length), 0);\nif (chapterChars < 100000) throw new Error('ORPHAN SNAPSHOT INCOMPLETE — kb_book_chapters content total ' + chapterChars + ' chars (expected 100k+). Aborting rather than writing a hollow manuscript backup.');\nconst d = new Date().toISOString().split('T')[0];\nconst snapshot = { generated: d, note: 'Orphan-table backstop — tables not in the main Every-3-Day SQL Snapshot.', counts: { kb_conclusions: conclusions.length, fold_history: fold.length, kb_pamphlets: pamphlets.length, kb_books: books.length, kb_book_chapters: chapters.length, chapter_chars: chapterChars }, kb_conclusions: conclusions, fold_history: fold, kb_pamphlets: pamphlets, kb_books: books, kb_book_chapters: chapters };\nconst content = JSON.stringify(snapshot, null, 2);\nconst title = 'TRUTH_Orphan_Snapshot_' + d + '.json';\nreturn [{ json: { content, title, snapshot_date: d, counts: snapshot.counts } }];"}},{"id":"1aefbc01-cc80-49ca-84d9-bfd6c97f3ac4","name":"Save Orphan Snapshot File","type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[1120,0],"parameters":{"operation":"createFromText","content":"={{ $json.content }}","name":"={{ $json.title }}","driveId":{"__rl":true,"mode":"list","value":"My Drive"},"folderId":{"__rl":true,"mode":"id","value":"1r2expT2tdtkutuc0hmCdqrA8r2g3n-AO"},"option