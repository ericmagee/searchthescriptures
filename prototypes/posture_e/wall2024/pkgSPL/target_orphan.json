ks = $('Fetch kb_books').all().map(x => x.json);\nconst chapters = $('Fetch kb_book_chapters').all().map(x => x.json);\nconst opDoc = $('Fetch operational_doc').all().map(x => x.json);\n// ASK 226 (pkgSPL): the operational_doc version history moved here from the main snapshot. Same rule as the main gate:\n// CAPTURED is compared against LIVE (snapshot_live_counts, read before the fetches); a malformed live count or a shortfall refuses the run.\nconst lc = $('Fetch live counts').first().json;\nconst live = (lc && typeof lc === 'object' && !Array.isArray(lc)) ? lc : (Array.isArray(lc) && lc.length ? lc[0] : {});\nconst isCount = (v) => typeof v === 'number' && Number.isInteger(v) && v >= 0;\nif (!isCount(live.operational_doc)) throw new Error('ORPHAN SNAPSHOT REFUSED - operational_doc live count is not a non-negative integer (' + JSON.stringify(live.operational_doc) + '). Refusing to write a backup that cannot be checked.');\nif (opDoc.length < live.operational_doc) throw new Error('ORPHAN SNAPSHOT REFUSED - operational_doc captured ' + opDoc.length + ' of ' + live.operational_doc + '. Aborting rather than writing a partial backup.');\nif (conclusions.length === 0 || fold.length === 0 || pamphlets.length === 0 || books.length === 0 || chapters.length === 0 || opDoc.length === 0) throw new Error('ORPHAN SNAPSHOT INCOMPLETE — a table fetched zero rows (conclusions=' + conclusions.length + ' fold=' + fold.length + ' pamphlets=' + pamphlets.length + ' books=' + books.length + ' chapters=' + chapters.length + ' operational_doc=' + opDoc.length + '). Aborting rather than writing a hollow backup.');\nconst chapterChars = chapters.reduce((s, c) => s + ((c.content || '').length), 0);\nif (chapterChars < 100000) throw new Error('ORPHAN SNAPSHOT INCOMPLETE — kb_book_chapters content total ' + chapterChars + ' chars (expected 100k+). Aborting rather than writing a hollow manuscript backup.');\nconst d = new Date().toISOString().split('T')[0];\nconst snapshot = { generated: d, note: 'Orphan-table backstop — tables not in the main Every-3-Day SQL Snapshot, and the operational_doc version history (ASK 226).', counts: { kb_conclusions: conclusions.length, fold_history: fold.length, kb_pamphlets: pamphlets.length, kb_books: books.length, kb_book_chapters: chapters.length, chapter_chars: chapterChars, operational_doc: opDoc.length }, live_counts: { operational_doc: live.operational_doc }, kb_conclusions: conclusions, fold_history: fold, kb_pamphlets: pamphlets, kb_books: books, kb_book_chapters: chapters, operational_doc: opDoc };\nconst content = JSON.stringify(snapshot, null, 2);\nconst title = 'TRUTH_Orphan_Snapshot_' + d + '.json';\nreturn [{ json: { content, title, snapshot_date: d, counts: snapshot.counts } }];"}},{"id":"1aefbc01-cc80-49ca-84d9-bfd6c97f3ac4","name":"Save Orphan Snapshot File","type":"n8n-nodes-base.googleDrive","typeVersion":3,"position":[1120,0],"parameters":{"operation":"createFromText","content":"={{ $json.content }}","name":"={{ $json.title }}","driveId":{"__rl":true,"mode":"list","value":"My Drive"},"folderId":{"__rl":true,"mode":"id","value":"1r2expT2tdtkutuc0hmCdqrA8r2g3n-AO"},"options":{"convertToGoogleDocument":false}},"credentials":{"googleDriveOAuth2Api":{"id":"4Q4jPVXgxNTLKRwX","name":"Google Drive OAuth2 API"}}},{"id":"66ee4d85-6783-4d4c-97e7-392c281e2074","name":"Log Orphan Snapshot to audit_log","type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[1344,0],"parameters":{"method":"POST","url":"https://bhffmkginddovmdcpnty.supabase.co/rest/v1/rpc/log_audit_event","sendHeaders":true,"specifyHeaders":"keypair","headerParameters":{"parameters":[{"name":"apikey","value":"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJoZmZta2dpbmRkb3ZtZGNwbnR5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4ODUxNjQsImV4cCI6MjA5NTQ2MTE2NH0.cdNxsU48LeMM8RBnmplA1TbRJo12OpJKNwCgYRJvwxA"},{"name":"Authorization","value":"Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJoZmZta2dpbmRkb3